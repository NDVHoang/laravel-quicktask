{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit",
        "lint:sunlint": "sunlint --all --input=resources/js",
        "lint:sunlint:changed": "sunlint --all --changed-files --input=resources/js",
        "lint:sunlint:security": "sunlint --security --input=resources/js"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@headlessui/react": "^2.0.0",
        "@inertiajs/react": "^2.0.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@sun-asterisk/sunlint": "^1.3.56",
        "@tailwindcss/forms": "^0.5.3",
        "@types/node": "^22.13.5",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-react": "^6.0.5",
        "autoprefixer": "^10.4.12",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "postcss": "^8.4.31",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "clsx": "^2.1.1",
        "concurrently": "^9.0.1",
        "globals": "^15.14.0",
        "laravel-vite-plugin": "^3.1",
        "lucide-react": "^1.28.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.3.3",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
